# Public application URL. Use the production Vercel URL, including https://.
APP_URL=https://your-project.vercel.app

# PostgreSQL connection string (Supabase, Neon, or another hosted PostgreSQL).
# Use a pooled connection string for the serverless Vercel runtime.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_BUCKET_NAME=voices

# Chatterbox text-to-speech API
CHATTERBOX_API_URL=https://your-chatterbox-api.example.com
CHATTERBOX_API_KEY=replace_me

# Polar billing
POLAR_ACCESS_TOKEN=replace_me
POLAR_SERVER=sandbox
POLAR_PRODUCT_ID=replace_me

# Optional: enables Sentry source-map uploads during Vercel builds.
# SENTRY_AUTH_TOKEN=replace_me
